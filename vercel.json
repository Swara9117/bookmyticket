{
    "builds": [{
        "src": "bookmyticket/wsgi.py",
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "50mb", "runtime": "python3.9" }
    }],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "bookmyticket/wsgi.py"
        }
    ],
    "crons": [
        {
            "path": "/internal/jobs/",
            "schedule": "*/5 * * * *"
        }
    ]
}